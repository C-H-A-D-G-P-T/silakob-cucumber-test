{
	"default": {
		"paths": ["features/**/*.feature"],
		"require": ["src/hooks/**/*.ts", "src/steps/**/*.ts"],
		"requireModule": ["ts-node/register"],
		"format": ["progress-bar", "summary", "html:reports/cucumber-report.html"],
		"formatOptions": {
			"snippetInterface": "async-await"
		},
		"publishQuiet": true
	}
}
